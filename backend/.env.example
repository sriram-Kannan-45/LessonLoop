APP_NAME=LessonLoop
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EVALUATOR_MODEL=gemini-3.5-flash

# Used automatically only after a Gemini quota/rate-limit response.
GROQ_FALLBACK_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_EVALUATOR_MODEL=qwen/qwen3.8-27b
# Conservative spacing for the free model's token-per-minute allowance.
GROQ_MIN_INTERVAL_SECONDS=65

PROVIDER_TIMEOUT_SECONDS=30
WORKFLOW_TIMEOUT_SECONDS=90
TECHNICAL_RETRIES=2
# DATABASE_PATH defaults to backend/data/lessonloop.sqlite3
